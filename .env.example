# Chép thành .env (KHÔNG commit .env).
#
# Dev (localhost): không cần file .env. `docker compose up` -> http://127.0.0.1:8800
#
# Production (VPS): chép file này thành .env rồi `docker compose up -d`
#   -> Caddy chạy kèm, https://QC_DOMAIN, cookie Secure.
COMPOSE_PROFILES=prod
QC_DOMAIN=research.quantechcap.com
QC_SECURE_COOKIE=1

# Cổng web trên 127.0.0.1 của máy (mặc định 8800). Trên VPS chỉ để debug qua SSH tunnel.
# QC_WEB_PORT=8800
